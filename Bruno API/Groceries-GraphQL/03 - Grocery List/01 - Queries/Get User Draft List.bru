meta {
  name: Get User Draft List
  type: graphql
  seq: 2
}

post {
  url: https://localhost:7298/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token:  {{access-token}}
}

body:graphql {
  {
    userDraftGroceryList(userId: "688b630df77dadbe36fc33b4") {
      id,
      totalPrice,
      completedAt,
      items {
        productItemId,
        productItemName,
        quantity,
        unitPrice,
      }
    }
  }
}
