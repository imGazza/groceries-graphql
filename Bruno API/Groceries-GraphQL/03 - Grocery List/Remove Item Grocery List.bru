meta {
  name: Remove Item Grocery List
  type: graphql
  seq: 6
}

post {
  url: https://localhost:7298/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation RemoveGroceryItem($groceryItem: GroceryItemInput!, $groceryListId: String) {
    removeItem(item: $groceryItem, groceryListId: $groceryListId){
      id,
      userId,
      totalPrice,
      items {
        productItemId
      }
    }
  }
}

body:graphql:vars {
  {
    "groceryItem": {
      "productItemId": "687fc49ce2355a6e61bea04a",
      "productItemName": "Almonds",
      "quantity": 0,
      "unitPrice": 0.5
    },
    "groceryListId": "688b6544f77dadbe36fc33b7"
  }
}
