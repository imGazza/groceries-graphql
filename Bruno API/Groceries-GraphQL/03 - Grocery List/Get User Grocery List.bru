meta {
  name: Get User Grocery List
  type: graphql
  seq: 2
}

post {
  url: https://localhost:7298/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  {
    userGroceryLists(userId: "688b630df77dadbe36fc33b4") {
      totalPrice,
      completedAt,
      items {
        productItemId,
        productItemName,
        quantity,
        unitPrice
      }
    }
  }
}
