meta {
  name: Catalog
  type: graphql
  seq: 1
}

post {
  url: https://localhost:7298/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{access-token}}
}

body:graphql {
  {
    catalog {
      name
      measurementUnit
      measurementQuantity
      price
      image {
        width,
        height
      }
    }
  }
  
}
