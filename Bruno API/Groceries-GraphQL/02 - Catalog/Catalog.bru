meta {
  name: Catalog
  type: graphql
  seq: 1
}

post {
  url: https://localhost:7298/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{access-token}}
}

body:graphql {
  query Catalog {
    catalog(
      order: [{ createdAt: DESC }]
      first: 10
      where: { name: { contains: "" } }
    ) {
      totalCount
      nodes {
        id
        name
      }
      pageInfo {
        hasNextPage
        endCursor
      }
    }
  }
  
}
