meta {
  name: Create Category
  type: graphql
  seq: 2
}

post {
  url: https://localhost:7298/graphql
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{access-token}}
}

body:graphql {
  mutation CreateCategory($categoryInput: CategoryInput!) {
    createCategory(categoryInput: $categoryInput)
  }
}

body:graphql:vars {
  {
    "categoryInput": {
      "name": "Vegetables",
      "iconName": "Salad"
    }
  }
}
