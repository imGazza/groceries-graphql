meta {
  name: 03 - Refresh Token
  type: graphql
  seq: 3
}

post {
  url: https://localhost:7298/graphql
  body: graphql
  auth: inherit
}

headers {
  Cookie: refreshToken=Pb6nH9NuWNBu1142bvqpSU3HDvls0LTi7p4XGjOAptM=
}

body:graphql {
  mutation RefreshToken(){
    refreshToken(){
      accessToken,
      user{
        id,
        email,
        firstName,
        lastName,
        roles
      }
    }
  }
}

script:post-response {
  var jsonData = res.getBody();
  bru.setEnvVar("access-token", jsonData.data.refreshToken.accessToken);
}
